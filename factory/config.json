{
  "version": "v1.3-phase-gate",
  "phase_gate": true,
  "rules_file": "docs/agents/standing-rules.md",
  "baseline": "factory/baseline-v1.json",
  "owner_name": "the repo owner",
  "lanes": {"clarify": 3, "build": 1},
  "max_rounds": 2,
  "base_branch": "main",
  "merge_method": "squash",
  "checks_timeout_s": 1200,
  "labels": {
    "queue": "factory",
    "needs_info": "needs-input",
    "needs_human": "factory:needs-human",
    "escaped": "factory:escaped",
    "ready_for_agent": "ready-for-agent"
  },
  "models": {
    "phase-planner": "opus",
    "intake": "opus",
    "spec-writer": "opus",
    "builder": "opus",
    "approver": "opus"
  },
  "routing": {
    "low": {
      "code": "haiku"
    },
    "medium": {
      "code": "sonnet"
    },
    "high": {
      "code": "sonnet"
    }
  },
  "surface_reviewers": {
    "security": {
      "security": "opus"
    },
    "eval": {
      "eval": "sonnet"
    }
  },
  "protected_paths": [
    "factory/",
    ".claude/",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE",
    ".github/"
  ],
  "always_in_scope": [],
  "automerge_allowlist": [
    "docs/*",
    "*.md",
    "tests/*"
  ]
}
